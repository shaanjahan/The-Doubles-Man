{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "checkoutId": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "pending"
    },
    "isSubscription": {
      "type": "boolean",
      "default": false
    },
    "subscriptionId": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    }
  },
  "required": [
    "checkoutId",
    "productId"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}